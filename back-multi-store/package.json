{
  "name": "back-multi-store",
  "version": "0.1.0",
  "private": true,
  "description": "API de multi-store: Express + Prisma + PostgreSQL",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
